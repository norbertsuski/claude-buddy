{
  "name": "claude-buddy",
  "private": true,
  "version": "0.12.0",
  "description": "A floating always-on-top macOS widget that shows what every local Claude Code session is doing, and tells you when one is waiting on you.",
  "license": "MIT",
  "author": "Norbert Suski",
  "repository": {
    "type": "git",
    "url": "https://github.com/norbertsuski/claude-buddy.git"
  },
  "bugs": {
    "url": "https://github.com/norbertsuski/claude-buddy/issues"
  },
  "homepage": "https://github.com/norbertsuski/claude-buddy",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "dmg": "./scripts/make-dmg.sh",
    "typecheck:local": "tsc -p tsconfig.local.json --noEmit",
    "dev:local": "BUDDY_UI_LOCAL=1 npm run tauri dev"
  },
  "dependencies": {
    "@buddy/ui": "github:norbertsuski/buddy-ui#v0.2.0",
    "@tauri-apps/api": "^2.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "claude-buddy",
  "version": "0.7.1",
  "identifier": "com.claude.buddy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "widget",
        "width": 200,
        "height": 40,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/norbertsuski/claude-buddy/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU2NDlBODdDOTZDMjMxMDMKUldRRE1jS1dmS2hKVmlmcVA5NVc5OFlLMDlyeVVud0xzdTJBT0RCY3hrZWJjVzFtQzRjNjFidFgK"
    }
  }
}
